{% extends 'base.html.twig' %}

{% block title %}Inscription - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-4 text-center fw-bold">Inscription</h1>

            {{ form_start(registrationForm) }}
                <div class="mb-3">
                    {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.username, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.username) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2 fw-bold mt-2">
                    Créer mon compte
                </button>
            {{ form_end(registrationForm) }}

            <div class="text-center mt-4">
                <span class="text-muted">Déjà inscrit ?</span>
                <a href="{{ path('app_login') }}" class="text-info text-decoration-none ms-1">Se connecter</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
