{% extends 'base.html.twig' %}

{% block title %}Inscription - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-4 text-center fw-bold text-white">Inscription</h1>

            {{ form_start(registrationForm) }}
                <div class="mb-3">
                    {{ form_label(registrationForm.username, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(registrationForm.username, {'attr': {'class': 'form-control bg-dark text-light border-secondary py-2'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.username) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control bg-dark text-light border-secondary py-2'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control bg-dark text-light border-secondary py-2'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
                </div>

                <button type="submit" class="btn-app btn-app-primary w-100 py-2.5 fw-medium mt-3 justify-content-center">
                    Créer mon compte
                </button>
            {{ form_end(registrationForm) }}

            <div class="text-center mt-3 pt-2 border-top border-secondary border-opacity-25">
                <span class="text-secondary small">Déjà inscrit ?</span>
                <a href="{{ path('app_login') }}" class="small ms-1 text-primary text-decoration-none fw-semibold">Se connecter</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
