{% extends 'base.html.twig' %}

{% block title %}Connexion - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-4 text-center fw-bold text-white">Connexion</h1>

            {% if error %}
                <div class="alert alert-danger mb-3" role="alert">
                    Nom d'utilisateur ou mot de passe incorrect.
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="mb-3">
                    <label for="username" class="form-label fw-medium text-light">Nom d'utilisateur</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control bg-dark text-light border-secondary py-2" autocomplete="username" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-medium text-light">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control bg-dark text-light border-secondary py-2" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn-app btn-app-primary w-100 py-2.5 fw-medium mt-3 justify-content-center" type="submit">
                    Se connecter
                </button>
            </form>

            <div class="text-center mt-3 pt-2 border-top border-secondary border-opacity-25">
                <span class="text-secondary small">Pas encore de compte ?</span>
                <a href="{{ path('app_register') }}" class="small ms-1 text-primary text-decoration-none fw-semibold">S'inscrire</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
