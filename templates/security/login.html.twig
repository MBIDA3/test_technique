{% extends 'base.html.twig' %}

{% block title %}Connexion - Cisad{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card p-4">
            <h1 class="h4 mb-4 text-center fw-bold">Connexion</h1>

            {% if error %}
                <div class="alert alert-danger mb-3" role="alert">
                    Nom d'utilisateur ou mot de passe incorrect.
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}">
                <div class="mb-3">
                    <label for="username" class="form-label">Nom d'utilisateur</label>
                    <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="username" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary w-100 py-2 fw-medium mt-2" type="submit">
                    Se connecter
                </button>
            </form>

            <div class="text-center mt-3">
                <span class="text-muted small">Pas encore de compte ?</span>
                <a href="{{ path('app_register') }}" class="small ms-1">S'inscrire</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
