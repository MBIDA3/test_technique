{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-8 col-lg-7">
        <div class="card card-custom p-4 shadow-lg">
            <div class="d-flex align-items-center mb-4">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 fs-2" style="width: 64px; height: 64px; min-width: 64px;">
                    <i class="fa-solid fa-user text-white"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-white">Mon Profil</h1>
                    <p class="text-secondary mb-0">Bienvenue sur votre espace, <strong class="text-white">{{ user.username }}</strong></p>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 mb-4">

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 border border-secondary border-opacity-30 rounded bg-dark">
                        <span class="text-secondary small d-block mb-1">Nom d'utilisateur</span>
                        <strong class="fs-5 text-light">{{ user.username }}</strong>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 border border-secondary border-opacity-30 rounded bg-dark">
                        <span class="text-secondary small d-block mb-1">Adresse Email</span>
                        <strong class="fs-5 text-light">{{ user.email }}</strong>
                    </div>
                </div>
            </div>

            <h2 class="h5 fw-bold text-white mb-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-chart-line text-primary"></i> Statistiques de Jeu & Rang
            </h2>

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="p-3 text-center border border-secondary border-opacity-30 rounded bg-dark d-flex flex-column align-items-center justify-content-center h-100">
                        <span class="text-secondary small d-block mb-2">Rang Actuel</span>
                        <span class="badge-rank badge-rank-silver rank-badge fs-6">
                            <i class="fa-solid fa-trophy text-warning me-1"></i> {{ infos ? infos.rank|default('Unranked') : 'Unranked' }}
                        </span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 text-center border border-secondary border-opacity-30 rounded bg-dark d-flex flex-column align-items-center justify-content-center h-100">
                        <span class="text-secondary small d-block mb-1">Victoires</span>
                        <strong class="display-6 fw-bold text-success font-monospace mb-0">{{ infos ? infos.victoire|default('0') : '0' }}</strong>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 text-center border border-secondary border-opacity-30 rounded bg-dark d-flex flex-column align-items-center justify-content-center h-100">
                        <span class="text-secondary small d-block mb-1">Défaites</span>
                        <strong class="display-6 fw-bold text-danger font-monospace mb-0">{{ infos ? infos.defaite|default('0') : '0' }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
