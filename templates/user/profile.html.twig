{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Cisad{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-7">
        <div class="card p-4">
            <h1 class="h3 fw-bold mb-4">Mon Profil</h1>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded border">
                        <span class="text-muted small d-block">Nom d'utilisateur</span>
                        <strong class="fs-5">{{ user.username }}</strong>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="p-3 bg-light rounded border">
                        <span class="text-muted small d-block">Adresse Email</span>
                        <strong class="fs-5">{{ user.email }}</strong>
                    </div>
                </div>
            </div>

            <h2 class="h5 fw-bold mb-3">Statistiques de jeu</h2>

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="p-3 text-center bg-light rounded border">
                        <span class="text-muted small d-block mb-1">Rang</span>
                        <span class="badge bg-primary fs-6 px-3 py-2 rank-badge">
                            {{ infos ? infos.rank|default('Unranked') : 'Unranked' }}
                        </span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 text-center bg-light rounded border">
                        <span class="text-muted small d-block mb-1">Victoires</span>
                        <strong class="fs-3 text-success font-monospace">{{ infos ? infos.victoire|default('0') : '0' }}</strong>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="p-3 text-center bg-light rounded border">
                        <span class="text-muted small d-block mb-1">Défaites</span>
                        <strong class="fs-3 text-danger font-monospace">{{ infos ? infos.defaite|default('0') : '0' }}</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
