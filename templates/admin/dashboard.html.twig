{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - Cisad{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Tableau de bord</h1>
    <div>
        <a href="{{ path('app_admin_csv_import') }}" class="btn btn-outline-primary me-2">
            Importer un CSV
        </a>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
            Créer un utilisateur
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card p-3">
            <span class="text-muted small">Total Utilisateurs</span>
            <h2 class="h3 fw-bold mb-0 mt-1">{{ total_users }}</h2>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-3">
            <span class="text-muted small">Total Statistiques</span>
            <h2 class="h3 fw-bold mb-0 mt-1">{{ total_infos }}</h2>
        </div>
    </div>
</div>

<div class="card p-0 overflow-hidden">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
        <h2 class="h6 fw-bold mb-0">Derniers utilisateurs créés</h2>
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-sm btn-link text-decoration-none">
            Voir tous les utilisateurs →
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom d'utilisateur</th>
                    <th>Email</th>
                    <th>Rang</th>
                    <th>Rôles</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in latest_users %}
                    <tr>
                        <td>{{ u.id }}</td>
                        <td><strong>{{ u.username }}</strong></td>
                        <td>{{ u.email }}</td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                {{ u.infos ? u.infos.rank|default('Unranked') : 'Unranked' }}
                            </span>
                        </td>
                        <td>
                            {% for role in u.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">ADMIN</span>
                                {% else %}
                                    <span class="badge bg-secondary">USER</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn btn-sm btn-outline-secondary">
                                Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">Aucun utilisateur enregistré.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
