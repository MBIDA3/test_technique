{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin - Cisad Gaming{% endblock %}

{% block body %}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 fw-bold text-white mb-1">Tableau de Bord Administrateur</h1>
        <p class="text-muted small mb-0">Aperçu rapide des métriques d'utilisateurs et des statistiques du serveur.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="{{ path('app_admin_csv_import') }}" class="btn-action btn-gradient-primary">
            <i class="fa-solid fa-file-import"></i> Importer CSV
        </a>
        <a href="{{ path('app_admin_user_new') }}" class="btn-action btn-gradient-success">
            <i class="fa-solid fa-user-plus"></i> Créer Utilisateur
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-custom p-4 d-flex flex-row align-items-center gap-4">
            <div class="p-3 bg-indigo-500 bg-opacity-20 text-indigo-400 rounded-3 fs-2">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <h3 class="display-6 fw-bold mb-0 text-white">{{ total_users }}</h3>
                <span class="text-muted small">Utilisateurs Enregistrés</span>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-custom p-4 d-flex flex-row align-items-center gap-4">
            <div class="p-3 bg-emerald-500 bg-opacity-20 text-emerald-400 rounded-3 fs-2">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <div>
                <h3 class="display-6 fw-bold mb-0 text-white">{{ total_infos }}</h3>
                <span class="text-muted small">Profils Statistiques Actifs</span>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom p-0 overflow-hidden">
    <div class="p-4 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
        <h2 class="h5 fw-bold mb-0 text-white"><i class="fa-solid fa-clock-rotate-left me-2"></i> Dernières Inscriptions</h2>
        <a href="{{ path('app_admin_user_index') }}" class="btn-action btn-action-sm btn-gradient-info">
            Voir tous les utilisateurs →
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom d'utilisateur</th>
                    <th>Email</th>
                    <th>Rang</th>
                    <th>Rôles</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in latest_users %}
                    {% set rankLower = u.infos and u.infos.rank ? u.infos.rank|lower : 'unranked' %}
                    {% set rankClass = 'badge-rank-silver' %}
                    {% if 'challenger' in rankLower %}
                        {% set rankClass = 'badge-rank-challenger' %}
                    {% elseif 'diamant' in rankLower or 'diamond' in rankLower %}
                        {% set rankClass = 'badge-rank-diamant' %}
                    {% elseif 'platine' in rankLower or 'platinum' in rankLower %}
                        {% set rankClass = 'badge-rank-platine' %}
                    {% elseif 'gold' in rankLower or 'or' in rankLower %}
                        {% set rankClass = 'badge-rank-gold' %}
                    {% elseif 'iron' in rankLower or 'fer' in rankLower %}
                        {% set rankClass = 'badge-rank-iron' %}
                    {% endif %}

                    <tr>
                        <td class="text-muted font-monospace small">#{{ u.id }}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2.5">
                                <div class="user-avatar-sm">
                                    {{ u.username|first|upper }}
                                </div>
                                <span class="fw-bold text-light">{{ u.username }}</span>
                            </div>
                        </td>
                        <td class="text-slate-300">{{ u.email }}</td>
                        <td>
                            <span class="badge-rank {{ rankClass }}">
                                {{ u.infos ? u.infos.rank|default('Unranked') : 'Unranked' }}
                            </span>
                        </td>
                        <td>
                            {% for role in u.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-rose-500 bg-opacity-20 text-rose-300 border border-rose-500 border-opacity-30 rounded-pill px-2.5 py-1">ADMIN</span>
                                {% else %}
                                    <span class="badge bg-slate-700 text-slate-300 rounded-pill px-2.5 py-1">USER</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <div class="d-flex align-items-center justify-content-end gap-1.5">
                                <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn-action btn-action-sm btn-gradient-info">
                                    <i class="fa-solid fa-pen-to-square"></i> Éditer
                                </a>
                                {% if u.infos %}
                                    <a href="{{ path('app_admin_infos_edit', {id: u.infos.id}) }}" class="btn-action btn-action-sm btn-gradient-warning">
                                        <i class="fa-solid fa-trophy"></i> Stats
                                    </a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
