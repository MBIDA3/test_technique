{% extends 'base.html.twig' %}

{% block title %}Importation CSV - Cisad{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card p-4">
            <h1 class="h4 mb-3 fw-bold">Importation d'utilisateurs via CSV</h1>
            <p class="text-muted small mb-3">
                Sélectionnez un fichier CSV structuré avec les colonnes suivantes :<br>
                <code>username;email;password;roles;rank;victoire;defaite</code>
            </p>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.file, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.file, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.file) }}</div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Importer le fichier
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
