{% extends 'base.html.twig' %}

{% block title %}Importation CSV - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-3 text-center fw-bold">Importation Utilisateurs via CSV</h1>
            <p class="text-muted text-center mb-4">
                Téléversez un fichier CSV respectant le format requis (ex: <code>username;email;password;roles;rank;victoire;defaite</code>).
            </p>

            <div class="alert alert-info py-2 px-3 small mb-4">
                💡 <strong>Conseil :</strong> Vous pouvez tester en important le fichier <code>test.csv</code> fourni avec le projet.
            </div>

            {{ form_start(form) }}
                <div class="mb-4">
                    {{ form_label(form.file, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.file, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                    <div class="text-danger small mt-1">{{ form_errors(form.file) }}</div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">← Retour</a>
                    <button type="submit" class="btn btn-primary-custom px-4 fw-bold">🚀 Lancer l'Importation</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
