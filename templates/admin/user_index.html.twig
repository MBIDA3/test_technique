{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs - Cisad Gaming{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Gestion des Utilisateurs</h1>
    <div>
        <a href="{{ path('app_admin_csv_import') }}" class="btn btn-primary-custom me-2">
            📥 Importer CSV
        </a>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-success">
            ➕ Créer Utilisateur
        </a>
    </div>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom d'utilisateur (`username`)</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Rang</th>
                    <th>Victoires</th>
                    <th>Défaites</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.id }}</td>
                        <td class="fw-bold text-info">{{ u.username }}</td>
                        <td>{{ u.email }}</td>
                        <td>
                            {% for role in u.roles %}
                                <span class="badge bg-{{ role == 'ROLE_ADMIN' ? 'danger' : 'secondary' }} me-1">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <span class="badge bg-primary px-2 py-1">
                                {{ u.infos ? u.infos.rank|default('Unranked') : 'Unranked' }}
                            </span>
                        </td>
                        <td><span class="text-success fw-bold">{{ u.infos ? u.infos.victoire|default('0') : '0' }}</span></td>
                        <td><span class="text-danger fw-bold">{{ u.infos ? u.infos.defaite|default('0') : '0' }}</span></td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn btn-sm btn-outline-info me-1">Modifier User</a>
                            {% if u.infos %}
                                <a href="{{ path('app_admin_infos_edit', {id: u.infos.id}) }}" class="btn btn-sm btn-outline-warning me-1">Modifier Stats</a>
                            {% endif %}
                            <form method="post" action="{{ path('app_admin_user_delete', {id: u.id}) }}" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted">Aucun utilisateur trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
