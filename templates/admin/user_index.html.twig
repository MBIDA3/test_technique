{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - Cisad{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Gestion des Utilisateurs</h1>
    <div>
        <a href="{{ path('app_admin_csv_import') }}" class="btn btn-outline-primary me-2">
            Importer un fichier CSV
        </a>
        <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
            Créer un utilisateur
        </a>
    </div>
</div>

<div class="card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom d'utilisateur</th>
                    <th>Email</th>
                    <th>Rôles</th>
                    <th>Rang</th>
                    <th class="text-center">Victoires</th>
                    <th class="text-center">Défaites</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                    <tr>
                        <td>{{ u.id }}</td>
                        <td><strong>{{ u.username }}</strong></td>
                        <td>{{ u.email }}</td>
                        <td>
                            {% for role in u.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="badge bg-danger">ADMIN</span>
                                {% else %}
                                    <span class="badge bg-secondary">USER</span>
                                {% endif %}
                            {% endfor %}
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                {{ u.infos ? u.infos.rank|default('Unranked') : 'Unranked' }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="text-success font-monospace fw-bold">
                                {{ u.infos ? u.infos.victoire|default('0') : '0' }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="text-danger font-monospace fw-bold">
                                {{ u.infos ? u.infos.defaite|default('0') : '0' }}
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="{{ path('app_admin_user_edit', {id: u.id}) }}" class="btn btn-sm btn-outline-secondary me-1">
                                Modifier
                            </a>
                            {% if u.infos %}
                                <a href="{{ path('app_admin_infos_edit', {id: u.infos.id}) }}" class="btn btn-sm btn-outline-info me-1">
                                    Stats
                                </a>
                            {% endif %}
                            <form method="post" action="{{ path('app_admin_user_delete', {id: u.id}) }}" class="d-inline" onsubmit="return confirm('Voulez-vous vraiment supprimer cet utilisateur ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ u.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    Supprimer
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Aucun utilisateur enregistré.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
