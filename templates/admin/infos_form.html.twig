{% extends 'base.html.twig' %}

{% block title %}Modifier Statistiques - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-2 text-center fw-bold text-white">Modifier les Statistiques</h1>
            <p class="text-center text-secondary small mb-4">Utilisateur : <strong class="text-white">{{ infos.user ? infos.user.username : 'N/A' }}</strong></p>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.rank, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(form.rank, {'attr': {'class': 'form-select bg-dark text-light border-secondary py-2'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.victoire, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(form.victoire, {'attr': {'class': 'form-control bg-dark text-light border-secondary py-2'}}) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.defaite, null, {'label_attr': {'class': 'form-label fw-medium text-light'}}) }}
                    {{ form_widget(form.defaite, {'attr': {'class': 'form-control bg-dark text-light border-secondary py-2'}}) }}
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a href="{{ path('app_admin_user_index') }}" class="btn-human btn-human-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn-human btn-human-amber px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Mettre à jour
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
