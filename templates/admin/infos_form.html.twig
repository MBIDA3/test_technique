{% extends 'base.html.twig' %}

{% block title %}Modifier Statistiques - Cisad{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card p-4">
            <h1 class="h4 mb-1 fw-bold">Modifier les statistiques</h1>
            <p class="text-muted small mb-4">Utilisateur : <strong>{{ infos.user ? infos.user.username : 'N/A' }}</strong></p>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.rank, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.rank, {'attr': {'class': 'form-select'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.victoire, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.victoire, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="mb-4">
                    {{ form_label(form.defaite, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.defaite, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Mettre à jour
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
