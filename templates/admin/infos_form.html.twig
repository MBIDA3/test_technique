{% extends 'base.html.twig' %}

{% block title %}Modifier Statistiques - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-3 text-center fw-bold">Modifier les Statistiques</h1>
            <p class="text-center text-muted mb-4">Utilisateur : <strong class="text-info">{{ infos.user ? infos.user.username : 'N/A' }}</strong></p>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.rank, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.rank, {'attr': {'class': 'form-select bg-dark text-light border-secondary'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.victoire, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.victoire, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.defaite, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.defaite, {'attr': {'class': 'form-control bg-dark text-light border-secondary'}}) }}
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">← Annuler</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold text-dark">Mettre à jour</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
