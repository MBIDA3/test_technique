{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Cisad Gaming{% endblock %}

{% block body %}
<div class="row justify-content-center mt-4">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 shadow-lg">
            <h1 class="h3 mb-4 text-center fw-bold text-white">{{ title }}</h1>

            {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_label(form.username, null, {'label_attr': {'class': 'form-label fw-semibold text-slate-200'}}) }}
                    {{ form_widget(form.username, {'attr': {'class': 'form-control bg-dark text-light border-secondary border-opacity-50 py-2'}}) }}
                    <div class="text-rose-400 small mt-1">{{ form_errors(form.username) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold text-slate-200'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control bg-dark text-light border-secondary border-opacity-50 py-2'}}) }}
                    <div class="text-rose-400 small mt-1">{{ form_errors(form.email) }}</div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label fw-semibold text-slate-200'}}) }}
                    {{ form_widget(form.plainPassword, {'attr': {'class': 'form-control bg-dark text-light border-secondary border-opacity-50 py-2'}}) }}
                    <div class="text-rose-400 small mt-1">{{ form_errors(form.plainPassword) }}</div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label fw-semibold text-slate-200'}}) }}
                    {{ form_widget(form.roles, {'attr': {'class': 'form-select bg-dark text-light border-secondary border-opacity-50 py-2'}}) }}
                    <div class="text-rose-400 small mt-1">{{ form_errors(form.roles) }}</div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a href="{{ path('app_admin_user_index') }}" class="btn-action btn-gradient-info">
                        <i class="fa-solid fa-arrow-left"></i> Annuler
                    </a>
                    <button type="submit" class="btn-action btn-gradient-success px-4">
                        <i class="fa-solid fa-check me-1"></i> Enregistrer
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
