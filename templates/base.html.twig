<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Cisad Gaming{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎮</text></svg>">
        <!-- Google Fonts: Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <!-- Bootstrap 5 CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- FontAwesome Open Source Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        
        <style>
            :root {
                --bg-body: #0b1120;
                --bg-card: #151d30;
                --border-card: #26334d;
                --text-primary: #f8fafc;
                --text-muted: #94a3b8;

                --btn-primary: #2563eb;
                --btn-primary-hover: #1d4ed8;
                --btn-success: #059669;
                --btn-success-hover: #047857;
                --btn-secondary: #334155;
                --btn-secondary-hover: #475569;
                --btn-amber: #d97706;
                --btn-amber-hover: #b45309;
                --btn-danger: #dc2626;
                --btn-danger-hover: #b91c1c;
            }

            body {
                background-color: var(--bg-body);
                color: var(--text-primary);
                min-height: 100vh;
                font-family: 'Inter', system-ui, sans-serif;
            }

            .card-custom {
                background-color: var(--bg-card);
                border: 1px solid var(--border-card);
                border-radius: 12px;
            }

            .navbar-custom {
                background-color: #070c18;
                border-bottom: 1px solid var(--border-card);
                padding: 0.85rem 0;
            }
            .navbar-brand {
                font-weight: 700;
                font-size: 1.25rem;
                color: #ffffff !important;
            }

            /* Active Navigation Link Styling */
            .nav-link {
                color: #94a3b8 !important;
                padding: 0.5rem 0.75rem !important;
                transition: color 0.15s ease, border-color 0.15s ease;
                border-bottom: 2px solid transparent;
            }
            .nav-link:hover {
                color: #f8fafc !important;
            }
            .nav-link.active {
                color: #ffffff !important;
                font-weight: 600 !important;
                border-bottom: 2px solid var(--btn-primary);
            }

            /* Alert Banners Contrast High Visibility */
            .alert-danger {
                background-color: #7f1d1d !important;
                border: 1px solid #b91c1c !important;
                color: #fef2f2 !important;
                font-weight: 500;
            }
            .alert-success {
                background-color: #064e3b !important;
                border: 1px solid #047857 !important;
                color: #ecfdf5 !important;
                font-weight: 500;
            }
            .alert-warning {
                background-color: #78350f !important;
                border: 1px solid #b45309 !important;
                color: #fefce8 !important;
                font-weight: 500;
            }
            .alert-info {
                background-color: #1e3a8a !important;
                border: 1px solid #1d4ed8 !important;
                color: #eff6ff !important;
                font-weight: 500;
            }

            /* Boutons professionnels */
            .btn-app {
                font-weight: 500;
                font-size: 0.875rem;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                transition: background-color 0.15s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                border: none;
                color: #ffffff !important;
                text-decoration: none;
                cursor: pointer;
                white-space: nowrap;
            }

            .btn-app-sm {
                padding: 0.375rem 0.75rem;
                font-size: 0.8125rem;
                border-radius: 6px;
            }

            .btn-app-primary { background-color: var(--btn-primary); }
            .btn-app-primary:hover { background-color: var(--btn-primary-hover); }

            .btn-app-success { background-color: var(--btn-success); }
            .btn-app-success:hover { background-color: var(--btn-success-hover); }

            .btn-app-secondary { background-color: var(--btn-secondary); }
            .btn-app-secondary:hover { background-color: var(--btn-secondary-hover); }

            .btn-app-amber { background-color: var(--btn-amber); }
            .btn-app-amber:hover { background-color: var(--btn-amber-hover); }

            .btn-app-danger { background-color: var(--btn-danger); }
            .btn-app-danger:hover { background-color: var(--btn-danger-hover); }

            /* Badges de Rangs */
            .badge-rank {
                font-weight: 600;
                padding: 0.35rem 0.75rem;
                border-radius: 6px;
                font-size: 0.75rem;
            }
            .badge-rank-challenger { background-color: #831843; color: #fbcfe8; border: 1px solid #9d174d; }
            .badge-rank-diamant { background-color: #164e63; color: #a5f3fc; border: 1px solid #155e75; }
            .badge-rank-platine { background-color: #064e3b; color: #a7f3d0; border: 1px solid #065f46; }
            .badge-rank-gold { background-color: #78350f; color: #fef08a; border: 1px solid #92400e; }
            .badge-rank-silver { background-color: #334155; color: #e2e8f0; border: 1px solid #475569; }
            .badge-rank-iron { background-color: #1e293b; color: #94a3b8; border: 1px solid #334155; }

            /* Tableaux */
            .table-app {
                --bs-table-bg: transparent;
                --bs-table-color: var(--text-primary);
                margin-bottom: 0;
            }
            .table-app th {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-muted);
                border-bottom: 1px solid var(--border-card);
                padding: 0.85rem 1rem;
                font-weight: 600;
                background-color: #0d1526;
            }
            .table-app td {
                padding: 0.85rem 1rem;
                border-bottom: 1px solid var(--border-card);
                vertical-align: middle;
            }
            .table-app tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.02);
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <i class="fa-solid fa-gamepad text-primary"></i> Cisad Gaming
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        {% if app.user %}
                            <li class="nav-item me-2">
                                <span class="badge bg-dark border border-secondary text-light px-3 py-2 fw-normal d-flex align-items-center gap-1.5">
                                    <i class="fa-solid fa-user text-secondary"></i> {{ app.user.username }}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <span class="badge bg-danger ms-1">ADMIN</span>
                                    {% else %}
                                        <span class="badge bg-info ms-1">USER</span>
                                    {% endif %}
                                </span>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.current_route == 'app_admin_dashboard' ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {{ app.current_route in ['app_admin_user_index', 'app_admin_user_new', 'app_admin_user_edit', 'app_admin_infos_edit'] ? 'active' : '' }}" href="{{ path('app_admin_user_index') }}">Utilisateurs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link {{ app.current_route == 'app_admin_csv_import' ? 'active' : '' }}" href="{{ path('app_admin_csv_import') }}">Importer CSV</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link {{ app.current_route == 'app_user_profile' ? 'active' : '' }}" href="{{ path('app_user_profile') }}">Mon Profil</a>
                                </li>
                            {% endif %}
                            <li class="nav-item ms-2">
                                <a class="btn-app btn-app-sm btn-app-danger" href="{{ path('app_logout') }}">
                                    Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link {{ app.current_route == 'app_login' ? 'active' : '' }}" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-app btn-app-primary ms-2" href="{{ path('app_register') }}">
                                    Inscription
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container mb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show mb-4" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-{{ label == 'error' or label == 'danger' ? 'triangle-exclamation' : 'circle-check' }} me-1"></i>
                            <div>{{ message }}</div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
