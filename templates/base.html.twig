<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Cisad Gaming - Platform{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎮</text></svg>">
        <!-- Google Fonts: Inter & Outfit -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
        <!-- Bootstrap 5 CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- FontAwesome Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        
        <style>
            :root {
                --bg-main: #0b0f19;
                --bg-card: rgba(22, 27, 46, 0.75);
                --bg-card-hover: rgba(30, 38, 64, 0.85);
                --border-color: rgba(255, 255, 255, 0.08);
                --accent-primary: #6366f1;
                --accent-primary-hover: #4f46e5;
                --accent-emerald: #10b981;
                --accent-purple: #8b5cf6;
                --accent-rose: #f43f5e;
                --accent-amber: #f59e0b;
                --text-muted: #94a3b8;
            }

            body {
                background: radial-gradient(circle at top center, #1e1b4b 0%, #0b0f19 60%, #05070e 100%);
                color: #f1f5f9;
                min-height: 100vh;
                font-family: 'Inter', sans-serif;
                background-attachment: fixed;
            }

            h1, h2, h3, h4, .navbar-brand {
                font-family: 'Outfit', sans-serif;
            }

            /* Custom Glassmorphism Cards */
            .card-custom {
                background: var(--bg-card);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                border: 1px solid var(--border-color);
                border-radius: 16px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }

            /* Navbar Styling */
            .navbar-custom {
                background: rgba(11, 15, 25, 0.8);
                backdrop-filter: blur(20px);
                border-bottom: 1px solid var(--border-color);
                padding: 0.85rem 0;
            }
            .navbar-brand {
                font-size: 1.4rem;
                background: linear-gradient(135deg, #a5b4fc 0%, #6366f1 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* Premium Buttons Design */
            .btn-action {
                border-radius: 10px;
                font-weight: 500;
                font-size: 0.875rem;
                padding: 0.5rem 1rem;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                border: none;
                text-decoration: none;
            }

            .btn-action-sm {
                padding: 0.375rem 0.75rem;
                font-size: 0.8125rem;
                border-radius: 8px;
            }

            .btn-gradient-primary {
                background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
                color: #ffffff;
                box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
            }
            .btn-gradient-primary:hover {
                background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
            }

            .btn-gradient-success {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: #ffffff;
                box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
            }
            .btn-gradient-success:hover {
                background: linear-gradient(135deg, #059669 0%, #047857 100%);
                color: #ffffff;
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
            }

            .btn-gradient-warning {
                background: rgba(245, 158, 11, 0.15);
                color: #fbbf24;
                border: 1px solid rgba(245, 158, 11, 0.3);
            }
            .btn-gradient-warning:hover {
                background: rgba(245, 158, 11, 0.25);
                color: #fef08a;
                border-color: rgba(245, 158, 11, 0.5);
            }

            .btn-gradient-info {
                background: rgba(99, 102, 241, 0.15);
                color: #a5b4fc;
                border: 1px solid rgba(99, 102, 241, 0.3);
            }
            .btn-gradient-info:hover {
                background: rgba(99, 102, 241, 0.25);
                color: #c7d2fe;
                border-color: rgba(99, 102, 241, 0.5);
            }

            .btn-gradient-danger {
                background: rgba(244, 63, 94, 0.15);
                color: #fda4af;
                border: 1px solid rgba(244, 63, 94, 0.3);
            }
            .btn-gradient-danger:hover {
                background: rgba(244, 63, 94, 0.3);
                color: #fff;
                border-color: rgba(244, 63, 94, 0.6);
            }

            /* Custom Badges */
            .badge-rank {
                font-weight: 600;
                padding: 0.35rem 0.75rem;
                border-radius: 20px;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .badge-rank-challenger {
                background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
                color: #fff;
                box-shadow: 0 0 10px rgba(236, 72, 153, 0.5);
            }
            .badge-rank-diamant {
                background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);
                color: #fff;
            }
            .badge-rank-platine {
                background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
                color: #fff;
            }
            .badge-rank-gold {
                background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
                color: #fff;
            }
            .badge-rank-silver {
                background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%);
                color: #fff;
            }
            .badge-rank-iron {
                background: linear-gradient(135deg, #475569 0%, #334155 100%);
                color: #cbd5e1;
            }

            /* Table Customization */
            .table-custom {
                --bs-table-bg: transparent;
                --bs-table-color: #e2e8f0;
                margin-bottom: 0;
            }
            .table-custom th {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--text-muted);
                border-bottom: 1px solid var(--border-color);
                padding: 1rem 1.25rem;
                font-weight: 600;
            }
            .table-custom td {
                padding: 1rem 1.25rem;
                border-bottom: 1px solid var(--border-color);
                vertical-align: middle;
            }
            .table-custom tbody tr {
                transition: background-color 0.2s ease;
            }
            .table-custom tbody tr:hover {
                background-color: var(--bg-card-hover);
            }

            .user-avatar-sm {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: linear-gradient(135deg, #6366f1, #a855f7);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                font-size: 0.9rem;
                color: #fff;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-5">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <i class="fa-solid fa-gamepad text-indigo-400"></i> Cisad Gaming
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        {% if app.user %}
                            <li class="nav-item me-2">
                                <div class="d-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-dark border border-secondary border-opacity-25">
                                    <div class="user-avatar-sm">
                                        {{ app.user.username|first|upper }}
                                    </div>
                                    <span class="fw-semibold text-light small">{{ app.user.username }}</span>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <span class="badge bg-danger bg-opacity-75 text-white rounded-pill px-2">ADMIN</span>
                                    {% else %}
                                        <span class="badge bg-info bg-opacity-75 text-white rounded-pill px-2">USER</span>
                                    {% endif %}
                                </div>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_dashboard') }}">
                                        <i class="fa-solid fa-chart-line me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_user_index') }}">
                                        <i class="fa-solid fa-users me-1"></i> Utilisateurs
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_csv_import') }}">
                                        <i class="fa-solid fa-file-csv me-1"></i> Importer CSV
                                    </a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_user_profile') }}">
                                        <i class="fa-solid fa-user me-1"></i> Mon Profil
                                    </a>
                                </li>
                            {% endif %}
                            <li class="nav-item ms-2">
                                <a class="btn-action btn-action-sm btn-gradient-danger" href="{{ path('app_logout') }}">
                                    <i class="fa-solid fa-power-off"></i> Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link text-slate-300" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-action btn-gradient-primary ms-2" href="{{ path('app_register') }}">
                                    <i class="fa-solid fa-user-plus"></i> Inscription
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container mb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show card-custom border-0 mb-4" role="alert">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-{{ label == 'error' ? 'circle-exclamation' : 'circle-check' }} fs-5"></i>
                            <div>{{ message }}</div>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
