<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Cisad Gaming{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎮</text></svg>">
        <!-- Google Fonts: Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <!-- Bootstrap 5 CDN -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <!-- FontAwesome Icons -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
        
        <style>
            /* Palette Humaine & Naturelle (Slate / Marine / Émeraude) */
            :root {
                --bg-body: #0f172a;        /* Slate 900 */
                --bg-surface: #1e293b;     /* Slate 800 */
                --bg-surface-hover: #334155;/* Slate 700 */
                --border-subtle: #334155;  /* Slate 700 */
                --text-primary: #f8fafc;   /* Slate 50 */
                --text-secondary: #94a3b8; /* Slate 400 */
                
                --btn-primary-bg: #2563eb; /* Bleu Professionnel */
                --btn-primary-hover: #1d4ed8;
                
                --btn-success-bg: #059669; /* Émeraude Naturel */
                --btn-success-hover: #047857;
                
                --btn-danger-bg: #dc2626;  /* Rouge Sobriété */
                --btn-danger-hover: #b91c1c;
            }

            body {
                background-color: var(--bg-body);
                color: var(--text-primary);
                min-height: 100vh;
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
            }

            /* Cartes Sobres et Professionnelles */
            .card-custom {
                background-color: var(--bg-surface);
                border: 1px solid var(--border-subtle);
                border-radius: 12px;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
            }

            /* Navigation Épurée */
            .navbar-custom {
                background-color: #0b1329;
                border-bottom: 1px solid var(--border-subtle);
                padding: 0.75rem 0;
            }
            .navbar-brand {
                font-weight: 700;
                font-size: 1.25rem;
                color: #ffffff !important;
            }

            /* Boutons Humains, Solides et Soignés */
            .btn-human {
                font-weight: 500;
                font-size: 0.875rem;
                padding: 0.5rem 1rem;
                border-radius: 8px;
                transition: background-color 0.15s ease, border-color 0.15s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                border: 1px solid transparent;
                text-decoration: none;
                cursor: pointer;
            }

            .btn-human-sm {
                padding: 0.35rem 0.75rem;
                font-size: 0.8125rem;
                border-radius: 6px;
            }

            /* Bouton Principal Bleu */
            .btn-human-primary {
                background-color: var(--btn-primary-bg);
                color: #ffffff;
            }
            .btn-human-primary:hover {
                background-color: var(--btn-primary-hover);
                color: #ffffff;
            }

            /* Bouton Succès Vert */
            .btn-human-success {
                background-color: var(--btn-success-bg);
                color: #ffffff;
            }
            .btn-human-success:hover {
                background-color: var(--btn-success-hover);
                color: #ffffff;
            }

            /* Bouton Secondaire / Édition */
            .btn-human-secondary {
                background-color: #334155;
                color: #f1f5f9;
                border-color: #475569;
            }
            .btn-human-secondary:hover {
                background-color: #475569;
                color: #ffffff;
            }

            /* Bouton Avertissement / Stats (Ambre doux) */
            .btn-human-amber {
                background-color: #d97706;
                color: #ffffff;
            }
            .btn-human-amber:hover {
                background-color: #b45309;
                color: #ffffff;
            }

            /* Bouton Danger / Supprimer */
            .btn-human-danger {
                background-color: #7f1d1d;
                color: #fca5a5;
                border-color: #991b1b;
            }
            .btn-human-danger:hover {
                background-color: var(--btn-danger-bg);
                color: #ffffff;
            }

            /* Badges de Rangs Simples et Lisibles */
            .badge-human {
                font-weight: 600;
                padding: 0.3rem 0.65rem;
                border-radius: 6px;
                font-size: 0.75rem;
            }
            .badge-human-challenger { background-color: #831843; color: #fbcfe8; border: 1px solid #9d174d; }
            .badge-human-diamant { background-color: #164e63; color: #a5f3fc; border: 1px solid #155e75; }
            .badge-human-platine { background-color: #064e3b; color: #a7f3d0; border: 1px solid #065f46; }
            .badge-human-gold { background-color: #78350f; color: #fef08a; border: 1px solid #92400e; }
            .badge-human-silver { background-color: #334155; color: #e2e8f0; border: 1px solid #475569; }
            .badge-human-iron { background-color: #1e293b; color: #94a3b8; border: 1px solid #334155; }

            /* Tableaux Sobres */
            .table-human {
                --bs-table-bg: transparent;
                --bs-table-color: var(--text-primary);
                margin-bottom: 0;
            }
            .table-human th {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--text-secondary);
                border-bottom: 1px solid var(--border-subtle);
                padding: 0.85rem 1rem;
                font-weight: 600;
                background-color: #111827;
            }
            .table-human td {
                padding: 0.85rem 1rem;
                border-bottom: 1px solid var(--border-subtle);
                vertical-align: middle;
            }
            .table-human tbody tr:hover {
                background-color: rgba(255, 255, 255, 0.03);
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_home') }}">
                    <i class="fa-solid fa-gamepad text-primary"></i> Cisad Gaming
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        {% if app.user %}
                            <li class="nav-item me-2">
                                <span class="badge bg-slate border border-secondary text-light px-3 py-2 fw-normal">
                                    👤 <strong>{{ app.user.username }}</strong>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <span class="badge bg-danger ms-1">ADMIN</span>
                                    {% else %}
                                        <span class="badge bg-info ms-1">USER</span>
                                    {% endif %}
                                </span>
                            </li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_dashboard') }}">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_user_index') }}">Utilisateurs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_admin_csv_import') }}">Importer CSV</a>
                                </li>
                            {% else %}
                                <li class="nav-item">
                                    <a class="nav-link text-slate-300" href="{{ path('app_user_profile') }}">Mon Profil</a>
                                </li>
                            {% endif %}
                            <li class="nav-item ms-2">
                                <a class="btn-human btn-human-sm btn-human-danger" href="{{ path('app_logout') }}">
                                    Déconnexion
                                </a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link text-slate-300" href="{{ path('app_login') }}">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-human btn-human-primary ms-2" href="{{ path('app_register') }}">
                                    Inscription
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container mb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show card-custom border-0 mb-4" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
